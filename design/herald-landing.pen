            {
              "type": "frame",
              "id": "t1EdHg",
              "name": "Article",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 20,
              "padding": [
                40,
                64
              ],
              "children": [
                {
                  "type": "text",
                  "id": "FF72c",
                  "name": "Crumb",
                  "fill": "$muted",
                  "content": "Getting started  ›  Send your first notification",
                  "fontFamily": "$sans",
                  "fontSize": 12,
                  "fontWeight": "500"
                },
                {
                  "type": "text",
                  "id": "IXTxP",
                  "name": "H1",
                  "fill": "$ink",
                  "content": "Send your first notification",
                  "fontFamily": "$display",
                  "fontSize": 44
                },
                {
                  "type": "text",
                  "id": "rVx5Q",
                  "name": "Lead",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Herald listens on 127.0.0.1:48617 and writes a bearer token to ~/Library/Application Support/Herald/token. Any process on your Mac that can read that file can send a banner.",
                  "lineHeight": 1.5,
                  "fontFamily": "$sans",
                  "fontSize": 17
                },
                {
                  "type": "text",
                  "id": "B2LK7I",
                  "name": "H2",
                  "fill": "$ink",
                  "content": "1. Register your app",
                  "fontFamily": "$display",
                  "fontSize": 26
                },
                {
                  "type": "text",
                  "id": "tNZeB",
                  "name": "P1",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A manifest tells Herald what your app can send: fields with types and sample values, the actions it offers, an icon. Register once; re-registering updates it.",
                  "lineHeight": 1.6,
                  "fontFamily": "$sans",
                  "fontSize": 15
                },
                {
                  "type": "frame",
                  "id": "PBBhV",
                  "name": "Code",
                  "width": "fill_container",
                  "fill": "$surface",
                  "cornerRadius": 10,
                  "stroke": "$line",
                  "strokeWidth": 1,
                  "layout": "vertical",
                  "gap": 4,
                  "padding": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "cZ7uS",
                      "name": "c",
                      "fill": "$ink",
                      "content": "curl -X POST http://127.0.0.1:48617/v1/apps \\",
                      "fontFamily": "$mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Y1laqU",
                      "name": "c",
                      "fill": "$ink",
                      "content": "  -H \"Authorization: Bearer $(cat ~/Library/Application\\ Support/Herald/token)\" \\",
                      "fontFamily": "$mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Hrs4h",
                      "name": "c",
                      "fill": "$ink",
                      "content": "  -d '{\"app\":\"ci.bot\",\"name\":\"CI Bot\",",
                      "fontFamily": "$mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Ni3hX",
                      "name": "c",
                      "fill": "$ink",
                      "content": "       \"fields\":[{\"name\":\"status\",\"type\":\"badge\",\"sample\":\"ok\"}],",
                      "fontFamily": "$mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "D0D3Fc",
                      "name": "c",
                      "fill": "$ink",
                      "content": "       \"actions\":[{\"id\":\"deploy\",\"label\":\"Deploy\",\"confirm\":true}]}'",
                      "fontFamily": "$mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "VXAQ3",
                  "name": "H2b",
                  "fill": "$ink",
                  "content": "2. Notify",
                  "fontFamily": "$display",
                  "fontSize": 26
                },
                {
                  "type": "frame",
                  "id": "wtvFs",
                  "name": "Code 2",
                  "width": "fill_container",
                  "fill": "$surface",
                  "cornerRadius": 10,
                  "stroke": "$line",
                  "strokeWidth": 1,
                  "layout": "vertical",
                  "gap": 4,
                  "padding": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "IxmBM",
                      "name": "c",
                      "fill": "$ink",
                      "content": "herald send --app ci.bot --title \"Build passed\" --body \"142 tests\" \\",
                      "fontFamily": "$mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "ih2n4",
                      "name": "c",
                      "fill": "$ink",
                      "content": "  --field status=ok --action deploy --speak \"Build passed.\"",
                      "fontFamily": "$mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "ELLvv",
                  "name": "P2",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The banner renders through the app’s default template until you design one. Open Designer → ci.bot to lay the fields out on the grid; every later notification uses it.",
                  "lineHeight": 1.6,
                  "fontFamily": "$sans",
                  "fontSize": 15
                },
                {
                  "type": "frame",
                  "id": "DQvhC",
                  "name": "Shot",
                  "width": "fill_container",
                  "height": 300,
                  "fill": "$wire",
                  "cornerRadius": 10,
                  "stroke": "$line",
                  "strokeWidth": 1
                },
                {
                  "type": "text",
                  "id": "onoRV",
                  "name": "Cap",
                  "fill": "$muted",
                  "content": "The resulting banner, with the Deploy action gated by an inline confirmation.",
                  "fontFamily": "$sans",
                  "fontSize": 12
                },
                {
                  "type": "frame",
                  "id": "yiDWb",
                  "name": "Callout",
                  "width": "fill_container",
                  "fill": "$accent-soft",
                  "cornerRadius": 8,
                  "gap": 10,
                  "padding": [
                    12,
                    16
                  ],
                  "children": [
                    {
                      "type": "icon",
                      "id": "LT105",
                      "name": "I",
                      "width": 16,
                      "height": 16,
                      "icon": "bot",
                      "library": "lucide",
                      "fill": "$accent"
                    },
                    {
                      "type": "text",
                      "id": "TI0ui",
                      "name": "C",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Using an agent? Settings → MCP installs herald-mcp for Claude Code, Codex or Claude Desktop, and the Agent quickstart hands it the same steps as tools.",
                      "lineHeight": 1.5,
                      "fontFamily": "$sans",
                      "fontSize": 13,
                      "fontWeight": "500"
                    }
                  ]
                },
                {
                  "type": "frame",
