    {
      "type": "note",
      "id": "wmRHr",
      "x": -342,
      "y": 3930,
      "name": "Build note — swapper",
      "width": 300,
      "height": 120,
      "content": "BUILD: Actions title = \"Buttons that\" + a LERP-style word swapper cycling the chips below the heading (same timing/easing as LERP: ~2.2 s hold, 400 ms ease-out-quint slide/fade, pauses on hover, respects reduced motion → shows 'do things')."
    },
    {
      "type": "note",
      "id": "tBUMm",
      "x": -276,
      "y": 637,
      "name": "Resolved — grid + v1",
      "width": 300,
      "height": 110,
      "content": "RESOLVED: all '3×4' wording replaced with 'a grid of any size'; the prose no longer names API paths (the /v1 prefix stays only inside real code samples: it is the versioned loopback API)."
    },
    {
      "type": "note",
      "id": "cdWek",
      "x": -322,
      "y": 3050,
      "name": "Build note — Designer section",
      "width": 320,
      "height": 200,
      "content": "BUILD: replace the placeholder with a real screenshot of the Designer (take it on the Mac, light and dark, 2× — the offscreen /v1/designer/snapshot draws AppKit controls black, so a real capture is needed). Numbered hotspots sit on the screenshot; hovering (or tapping) one dims the rest and shows its explanation card, exactly like the RAV site's interface showcase; the legend below is the no-hover/mobile fallback and doubles as the accessible text."
    },
    {
      "type": "note",
      "id": "enhko",
      "x": -342,
      "y": 4382,
      "name": "Resolved — agent speaks",
      "width": 300,
      "height": 110,
      "content": "RESOLVED: new section 'Let your agent speak to you' (cloud relay: spoken banners, Reply/Record, queued while away, one-switch enable) between Living with it and For agents; For agents now mentions cloud agents."
    }
